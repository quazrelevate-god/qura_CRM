# QURA website environment variables
#
# The QURA CRM intake endpoint. Read server-side by /api/intake.js.
# Leave empty to use the legacy backup route (Google Sheet + n8n).
# Set the real value in Vercel → Project → Settings → Environment Variables.
# Example: https://<crm-domain>/api/intake
PUBLIC_QURA_CRM_INTAKE_URL=
