# QURA website environment variables
#
# PUBLIC_QURA_CRM_INTAKE_URL — the QURA CRM intake endpoint, read server-side by
# /api/intake.js. If unset, the code falls back to the production default
# (https://qura-crm-one.vercel.app/api/intake), so leads reach the CRM either way.
# Every submission is ALSO written to the Google Sheet (and n8n) as a permanent
# backup, regardless of this value. Override here only to point at a different
# CRM deployment (e.g. a preview URL).
PUBLIC_QURA_CRM_INTAKE_URL=https://qura-crm-one.vercel.app/api/intake
